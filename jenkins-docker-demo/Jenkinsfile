
pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'lovestrant'
        IMAGE_NAME     = 'devops-tip-bot'
        DOCKERHUB_CREDS = credentials('dockerhub-creds')
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                bat 'python -m unittest -v'
            }
        }

        stage('Build Image') {
            steps {
                bat '''
                    docker build ^
                    --build-arg BUILD_TAG=%IMAGE_NAME%-%IMAGE_TAG% ^
                    -t %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG% ^
                    -t %DOCKERHUB_USER%/%IMAGE_NAME%:latest .
                '''
            }
        }

        stage('Smoke Test Image') {
            steps {
                bat 'docker run --rm %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG%'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                bat '''
                    @echo off
                    echo %DOCKERHUB_CREDS_PSW% | docker login -u %DOCKERHUB_CREDS_USR% --password-stdin
                    if errorlevel 1 exit /b 1

                    docker push %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG%
                    if errorlevel 1 exit /b 1

                    docker push %DOCKERHUB_USER%/%IMAGE_NAME%:latest
                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        always {
            bat '''
                docker logout
                docker rmi %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG% %DOCKERHUB_USER%/%IMAGE_NAME%:latest
                exit /b 0
            '''
        }

        success {
            echo "Pushed ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }
    }
}
