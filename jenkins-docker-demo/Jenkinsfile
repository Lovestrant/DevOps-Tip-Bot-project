pipeline {
    agent any

    environment {
        // CHANGE THESE
        DOCKERHUB_USER = 'lovestrant'
        IMAGE_NAME     = 'devops-tip-bot'
        // Jenkins credential (Username with password) holding Docker Hub login/token
        DOCKERHUB_CREDS = credentials('dockerhub-creds')
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'python3 -m unittest -v'
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                  docker build \
                    --build-arg BUILD_TAG=${IMAGE_NAME}-${IMAGE_TAG} \
                    -t ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} \
                    -t ${DOCKERHUB_USER}/${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Smoke Test Image') {
            steps {
                sh 'docker run --rm ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh '''
                  echo "$DOCKERHUB_CREDS_PSW" | docker login -u "$DOCKERHUB_CREDS_USR" --password-stdin
                  docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}
                  docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            sh 'docker rmi ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} ${DOCKERHUB_USER}/${IMAGE_NAME}:latest || true'
        }
        success { echo "Pushed ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}" }
        failure { echo 'Pipeline failed. Check the stage logs above.' }
    }
}
