
pipeline {
    agent any

    environment {
        DOCKERHUB_USER  = 'lovestrant'
        IMAGE_NAME      = 'devops-tip-bot'
        DOCKERHUB_CREDS = credentials('dockerhub-creds')
        IMAGE_TAG       = "${BUILD_NUMBER}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir('jenkins-docker-demo') {
                    bat '''
                        "C:\\Users\\malov\\AppData\\Local\\Programs\\Python\\Python315\\python.exe" -m unittest discover -s . -p "test_app.py" -v
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                dir('jenkins-docker-demo') {
                    bat '''
                        docker build ^
                        --build-arg BUILD_TAG=%IMAGE_NAME%-%IMAGE_TAG% ^
                        -t %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG% ^
                        -t %DOCKERHUB_USER%/%IMAGE_NAME%:latest .
                    '''
                }
            }
        }

        stage('Smoke Test Image') {
            steps {
                bat '''
                    docker run --rm %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG%
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                bat '''
                    @echo off

                    echo %DOCKERHUB_CREDS_PSW% | docker login -u %DOCKERHUB_CREDS_USR% --password-stdin

                    if errorlevel 1 exit /b 1

                    docker push %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG%

                    if errorlevel 1 exit /b 1

                    docker push %DOCKERHUB_USER%/%IMAGE_NAME%:latest

                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }

    post {
        always {
            bat '''
                @echo off

                docker logout

                docker rmi %DOCKERHUB_USER%/%IMAGE_NAME%:%IMAGE_TAG% 2>nul

                docker rmi %DOCKERHUB_USER%/%IMAGE_NAME%:latest 2>nul

                exit /b 0
            '''
        }

        success {
            echo "Successfully pushed ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }
    }
}
